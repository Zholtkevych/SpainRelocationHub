# Copy to .env.local for development.

# Without this set, lead form submissions log to the console instead of
# sending real email (see lib/lead/email.ts).
RESEND_API_KEY=
LEAD_FROM_EMAIL="Spain Relocation Hub <onboarding@resend.dev>"
LEAD_NOTIFICATION_EMAIL=madrid.relocation.expert@gmail.com

# WhatsApp number in international format without "+" (defaults to the
# number found in the original prototype — confirm before launch).
NEXT_PUBLIC_WHATSAPP_NUMBER=34611209004

# Production domain — drives canonical URLs, hreflang, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (leads + content editor). ADMIN_EMAIL/ADMIN_PASSWORD_HASH are
# bootstrap-only — they seed the one row in the admin_users table the first
# time it's empty; after that, the database is authoritative and the admin
# can change their password via /admin/forgot-password without touching
# these again. ADMIN_PASSWORD_HASH is never the plain password — generate
# it with:
#   node scripts/hash-admin-password.mjs "your password"
# (format uses ":" as a delimiter, not "$" — Next.js's .env loader treats
# "$name" as a reference to another env var and mangles it otherwise)
# ADMIN_SESSION_SECRET can be any long random string (e.g. `openssl rand -hex 32`).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# GA4 Measurement ID (G-XXXXXXXXXX). Without it set, no analytics script
# loads at all — this is optional, not required to run the site. When set,
# it only loads after a visitor accepts the cookie banner (see
# components/GoogleAnalytics.tsx and PRD FR-12.2).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
