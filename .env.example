# Copy to .env.local for development.

# Without this set, lead form submissions log to the console instead of
# sending real email (see lib/lead/email.ts).
RESEND_API_KEY=
LEAD_FROM_EMAIL="Spain Relocation Hub <onboarding@resend.dev>"
LEAD_NOTIFICATION_EMAIL=madrid.relocation.expert@gmail.com

# WhatsApp number in international format without "+" (defaults to the
# number found in the original prototype — confirm before launch).
NEXT_PUBLIC_WHATSAPP_NUMBER=34611209004

# Production domain — drives canonical URLs, hreflang, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
